<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header Wave Background -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="180dp"> <!-- Ruang ekstra untuk Floating Nav -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Jarak atas yang lebih lega (64dp) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="64dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Welcome!"
                android:textColor="@color/white"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Explore your fishing journey"
                android:textColor="@color/purple_light"
                android:textSize="18sp" />

            <!-- Featured Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="56dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivHeroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hape" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#35000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="28dp"
                        android:text="Featured Fishing Tips"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_marginBottom="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="Module Learning"
                android:textColor="@color/black"
                android:textSize="22sp" />

            <!-- Buttons dengan Spasi yang Lega (Margin 28dp) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 2"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconPadding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 3"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_view"
                app:iconPadding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 4"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconPadding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 5"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_search"
                app:iconPadding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 7"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_manage"
                app:iconPadding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 9"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_my_calendar"
                app:iconPadding="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan10"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="28dp"
                android:paddingStart="24dp"
                android:text="Pertemuan 10"
                android:textAlignment="viewStart"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconPadding="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>