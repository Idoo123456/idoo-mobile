<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Artistic Wave Header -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp">

            <!-- Welcome Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Welcome!"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Silahkan pilih..."
                android:textColor="@color/purple_light"
                android:textSize="16sp" />

            <!-- Hero Banner / Featured Content -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="40dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivHeroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hape" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#40000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="20dp"
                        android:text="Explore FishBook"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Learning Modules -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Pertemuan"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Pertemuan 2 Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Pertemuan 2"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp" />

            <!-- Pertemuan 3 Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 3"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp" />

            <!-- Pertemuan 4 Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan4"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 4"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp" />

            <!-- Pertemuan 5 Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan5"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 5"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp" />

            <!-- Pertemuan 7 Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan7"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 7"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp" />

            <!-- Pertemuan 9 Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardPertemuan9"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 9"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_primary"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>